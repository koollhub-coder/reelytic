# Google Identity Services client ID. Without this set, "Continue with
# Google" runs in DUMMY mode (see server/routes/auth.routes.js POST /google) --
# fine for local dev/demo, not for real sign-ins.
VITE_GOOGLE_CLIENT_ID=

# Baked into the client bundle at build time -- used for canonical/Open Graph
# tags and JSON-LD (index.html's %VITE_APP_URL% and useDocumentMeta.jsx).
# Mirrors the server's APP_URL (see the root .env.example); keep the two in
# sync. No trailing slash. Example once a real domain is live: https://tryreelytic.com
VITE_APP_URL=http://localhost:5173
