MONGODB_URI=mongodb://localhost:27017/reelytic
APIFY_API_KEY=your_apify_api_key_here
MONGODB_DB_NAME=reelytic
SESSION_SECRET=reelytic_super_secret_key_12345
PORT=3000
APP_TIMEZONE=Asia/Kolkata
CACHE_TTL_DAYS=7
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# The single source of truth for this app's public URL -- every place that
# needs to build a full link (password-reset emails, alert "Open Health page"
# buttons, robots.txt/sitemap.xml, canonical/Open Graph tags) reads this
# instead of a hardcoded domain, so switching domains later is a one-line
# change here, not a find-and-replace across the codebase. No trailing slash.
# Example once a real domain is live: https://tryreelytic.com
# APP_URL=http://localhost:5173
APP_URL=https://reelytic.onrender.com/

# Required for self-service signup's email OTP step (server/services/mailer.service.js).
# Get a key at https://resend.com (free tier: 3,000 emails/month). Without this set,
# signup will create the account row but fail to send the code -- see the setup
# steps in that service's own comments for what "verify a domain" means and why
# it matters before this can reach real users, not just your own inbox.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend (e.g. otp@yourdomain.com).
# Defaults to onboarding@resend.dev, which can ONLY deliver to the email address
# your Resend account itself was signed up with -- fine for testing, not for real users.
OTP_EMAIL_FROM=
