{
  "name": "reelytic",
  "version": "2.0.0",
  "description": "Campaign reports in minutes, not workdays.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"node server/index.js\" \"cd client && npm run dev\"",
    "build": "cd client && npm install && npm run build",
    "postinstall": "cd client && npm install",
    "alert:test": "node scripts/alert-test.js",
    "regress": "node scripts/regress.js",
    "regress:api": "node scripts/regress.js api",
    "regress:ui": "node scripts/regress.js ui",
    "regress:free": "node scripts/regress.js --no-spend",
    "regress:canary": "node scripts/canary.js",
    "credits:audit": "node scripts/credit-reconcile.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "google-auth-library": "^10.9.0",
    "mongodb": "^6.5.0",
    "multer": "^1.4.5-lts.1",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^8.2.2"
  }
}
